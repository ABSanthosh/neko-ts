{
  "name": "neko-ts",
  "private": false,
  "version": "0.0.7",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/ABSanthosh/neko-ts",
  "author": "ABSanthosh <a.b.santhosh02@gmail.com>",
  "homepage": "https://ABSanthosh.github.io/neko-ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build && touch storybook-static/.nojekyll",
    "deploy": "yarn build-storybook && gh-pages -d storybook-static",
    "format": "prettier --write \"src/**/*.ts\" \"stories/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"stories/**/*.ts\""
  },
  "main": "./dist/neko-ts.cjs",
  "module": "./dist/neko-ts.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/neko-ts.js",
      "require": "./dist/neko-ts.cjs"
    },
    "./breeds": {
      "types": "./dist/breeds/index.d.ts",
      "import": "./dist/breeds/index.js",
      "require": "./dist/breeds/index.cjs"
    },
    "./breeds/*": {
      "import": "./dist/breeds/*.js",
      "require": "./dist/breeds/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@storybook/addon-links": "^10.4.2",
    "@storybook/html": "^10.4.2",
    "@storybook/html-vite": "^10.4.2",
    "@types/node": "^25.9.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.2",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^5.0.2"
  },
  "resolutions": {
    "jackspeak": "2.1.1"
  },
  "keywords": [
    "neko",
    "neko-ts",
    "oneko.js",
    "oneko",
    "jneko",
    "Kenji Gotoh neko",
    "Tatsuya Kato onkeo",
    "Masayuki Koba xneko",
    "neko.js",
    "xneko",
    "following mouse",
    "cat",
    "fun"
  ]
}
